# Copy this file to .env.e2e.local and fill in real credentials.
# The default Playwright projects target the deployed web apps directly.
#
# THREE DISTINCT ACCOUNTS ARE REQUIRED. They must be three different users.
# E2E_USER and E2E_LINE_MANAGER_* deliberately have NO fallback to STAGING_*:
# aliasing them made "staff", "line manager" and "manager" the same owner
# account, so every permission spec was asserting a boundary against the very
# account that is allowed to cross it. A spec whose tier is unset now SKIPS
# LOUDLY instead of quietly running as somebody else.

# ── Tier 1: STAFF ───────────────────────────────────────────────────────
# A "Jarz POS Staff" account with NO manager role of any kind.
# Drives every @staff spec and every "staff is denied X" assertion.
E2E_USER=
E2E_PASSWORD=

# ── Tier 2: LINE MANAGER ────────────────────────────────────────────────
# A "JARZ line manager" account that is NOT also JARZ Manager / System Manager
# / Administrator / B2B Sales Rep / any production role.
# Drives e2e/specs/line-manager.api.spec.js: ALLOWED cancel + return + shift
# monitor + manager dashboard + materials report; DENIED pricing writes, B2B,
# the Production Board and the manager-only reports.
E2E_LINE_MANAGER_USER=
E2E_LINE_MANAGER_PASSWORD=

# ── Tier 3: MANAGER ─────────────────────────────────────────────────────
# A "JARZ Manager" (or Administrator) account.
# Falls back to STAGING_USER / STAGING_PASSWORD, because the owner credential
# genuinely IS this tier.
E2E_MANAGER_USER=
E2E_MANAGER_PASSWORD=

# ── Options ─────────────────────────────────────────────────────────────
# POS profile used by the staff workflow suite. Falls back to STAGING_POS_PROFILE.
E2E_POS_PROFILE=

# Login mode chosen in the post-login dialog, for UI specs.
# Supported values: employee, line-manager
E2E_LOGIN_MODE=

# Set to 1 in CI to turn every "missing credentials" SKIP into a hard FAILURE,
# so a permission suite can never report green off an empty .env.
E2E_STRICT_CREDENTIALS=

# Optional base URL override, for example:
# E2E_BASE_URL=http://127.0.0.1:4173
